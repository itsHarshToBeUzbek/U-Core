{
  "manifest_version": 3,
  "name": "Uzum ПВЗ Помощник",
  "version": "2.14.0",
  "description": "Калькулятор инкассации, печать инфолистов, актов приёма-передачи и актов на диагностику, сбор данных приёмки по кнопке",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Открыть помощника",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://dp.uzum.uz/*",
    "https://api-wms.uzum.uz/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://dp.uzum.uz/*"
      ],
      "js": [
        "wms-harvester.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://dp.uzum.uz/*"
      ],
      "js": [
        "wms-parse.js",
        "content.js",
        "placement.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/uzum_logo.svg"
      ],
      "matches": [
        "https://dp.uzum.uz/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
